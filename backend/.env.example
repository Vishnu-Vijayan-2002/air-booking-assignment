# Django Configuration
DJANGO_SECRET_KEY=django-insecure-airbooking-yuai-soft-solutions-fullstack-dev
DJANGO_DEBUG=True

# Celery Configuration
# By default CELERY_ALWAYS_EAGER=True runs tasks synchronously without needing Redis running.
# Set to False if you run a Redis broker (redis-server) and want Celery workers.
CELERY_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Email Delivery Configuration
# Default is console backend (outputs to terminal & records in ActivationEmailLog for audit)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# External Flight Radar APIs (Optional)
AIRLABS_API_KEY=
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
